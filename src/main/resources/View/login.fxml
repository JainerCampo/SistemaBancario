<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="600.0" maxWidth="900.0" minHeight="600.0" minWidth="900.0" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginController">

    <center>

        <HBox alignment="CENTER" spacing="0.0">

            <!-- ================================================= -->
            <!-- PANEL IZQUIERDO / MARCA DEL BANCO                 -->
            <!-- ================================================= -->

            <VBox alignment="CENTER" maxWidth="390.0" prefWidth="390.0" spacing="20.0" style="-fx-background-color: #123B5D;">

                <children>

                    <!-- ESPACIO PARA EL LOGO -->

                    <StackPane maxHeight="150.0" maxWidth="150.0" prefHeight="150.0" prefWidth="150.0">

                        <children>

                            <!--
                                Aquí posteriormente colocaremos
                                el logo real del banco.

                                Puedes reemplazar este Circle
                                por un ImageView.
                            -->

                            <Circle radius="65.0" style="-fx-fill: white;" />

                            <Label text="LOGO" textFill="#123B5D">

                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>

                            </Label>

                        </children>

                    </StackPane>


                    <Label text="DANIBANCA" textFill="WHITE">

                        <font>
                            <Font name="System Bold" size="30.0" />
                        </font>

                    </Label>


                    <Label text="Sistema Bancario" textFill="#D9E5EE">

                        <font>
                            <Font size="16.0" />
                        </font>

                    </Label>


                    <Label text="Gestión segura y eficiente" textFill="#B8CBD9">

                        <font>
                            <Font size="13.0" />
                        </font>

                    </Label>

                </children>

            </VBox>


            <!-- ================================================= -->
            <!-- PANEL DERECHO / LOGIN                             -->
            <!-- ================================================= -->

            <VBox alignment="CENTER" maxWidth="510.0" prefWidth="510.0" spacing="18.0" style="-fx-background-color: white;">

                <padding>
                    <Insets bottom="50.0" left="70.0" right="70.0" top="50.0" />
                </padding>

                <children>


                    <!-- TITULO -->

                    <VBox alignment="CENTER" spacing="5.0">

                        <children>

                            <Label text="Iniciar sesión">

                                <font>
                                    <Font name="System Bold" size="30.0" />
                                </font>

                            </Label>


                            <Label text="Ingrese sus credenciales para continuar" textFill="#707070">

                                <font>
                                    <Font size="14.0" />
                                </font>

                            </Label>

                        </children>

                    </VBox>


                    <!-- ESPACIO -->

                    <VBox prefHeight="10.0" />


                    <!-- USUARIO -->

                    <VBox spacing="7.0">

                        <children>

                            <Label text="Usuario">

                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>

                            </Label>


                            <TextField fx:id="txtUserSignIn" onKeyTyped="#eventKey" prefHeight="42.0" promptText="Ingrese su usuario" style="-fx-background-radius: 6px;                                               -fx-border-radius: 6px;                                               -fx-border-color: #D5DADF;                                               -fx-background-color: #FAFBFC;">

                                <font>
                                    <Font size="14.0" />
                                </font>

                            </TextField>

                        </children>

                    </VBox>


                    <!-- CONTRASEÑA -->

                    <VBox spacing="7.0">

                        <children>

                            <Label text="Contraseña">

                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>

                            </Label>


                            <StackPane>

                                <children>

                                    <PasswordField fx:id="txtPasswordSignIn" onKeyTyped="#eventKey" prefHeight="42.0" promptText="Ingrese su contraseña" style="-fx-background-radius: 6px;                                                           -fx-border-radius: 6px;                                                           -fx-border-color: #D5DADF;                                                           -fx-background-color: #FAFBFC;">

                                        <font>
                                            <Font size="14.0" />
                                        </font>

                                    </PasswordField>


                                    <TextField fx:id="txtPasswordSignInMask" managed="false" onKeyTyped="#eventKey" prefHeight="42.0" promptText="Ingrese su contraseña" style="-fx-background-radius: 6px;                                                       -fx-border-radius: 6px;                                                       -fx-border-color: #D5DADF;                                                       -fx-background-color: #FAFBFC;" visible="false">

                                        <font>
                                            <Font size="14.0" />
                                        </font>

                                    </TextField>

                                </children>

                            </StackPane>


                            <CheckBox fx:id="checkViewPassSignIn" mnemonicParsing="false" text="Mostrar contraseña">

                                <font>
                                    <Font size="13.0" />
                                </font>

                            </CheckBox>

                        </children>

                    </VBox>


                    <!-- BOTON -->

                    <Button fx:id="btnSignIn" maxWidth="Infinity" mnemonicParsing="false" onAction="#actionEvent" prefHeight="45.0" style="-fx-background-color: #123B5D;                                    -fx-background-radius: 6px;                                    -fx-border-radius: 6px;" text="INGRESAR" textFill="WHITE">

                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>

                    </Button>


                    <!-- LIMPIAR -->

                    <Button fx:id="btnClean" maxWidth="Infinity" mnemonicParsing="false" onAction="#actionEvent" prefHeight="35.0" style="-fx-background-color: transparent;                                    -fx-text-fill: #123B5D;                                    -fx-border-color: transparent;" text="Limpiar">

                        <font>
                            <Font size="13.0" />
                        </font>

                    </Button>


                    <!-- PIE -->

                    <Label text="Acceso autorizado únicamente para usuarios registrados" textFill="#929292" wrapText="true">

                        <font>
                            <Font size="11.0" />
                        </font>

                    </Label>

                </children>

            </VBox>

        </HBox>

    </center>


    <!-- ========================================================= -->
    <!-- PIE DE VENTANA                                            -->
    <!-- ========================================================= -->

    <bottom>

        <HBox alignment="CENTER">

            <padding>
                <Insets bottom="8.0" top="8.0" />
            </padding>

            <children>

                <Label text="© DANIBANCA · Sistema Bancario" textFill="#777777">

                    <font>
                        <Font size="11.0" />
                    </font>

                </Label>

            </children>

        </HBox>

    </bottom>

</BorderPane>

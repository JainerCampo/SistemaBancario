<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.TransaccionesController" style="-fx-background-color:#F4F6F8;">
 <top><VBox spacing="12" style="-fx-background-color:#123B5D;"><padding><Insets bottom="20" left="30" right="30" top="20" /></padding><Label text="Operaciones financieras" textFill="WHITE"><font><Font name="System Bold" size="24" /></font></Label><HBox spacing="8"><ToggleButton fx:id="tbConsignar" text="Consignar" prefHeight="44" /><ToggleButton fx:id="tbRetirar" text="Retirar" prefHeight="44" /><ToggleButton fx:id="tbTransferir" text="Transferir" prefHeight="44" /></HBox></VBox></top>
 <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><content><VBox spacing="16"><padding><Insets bottom="30" left="30" right="30" top="24" /></padding>
  <VBox fx:id="panelConsignar" spacing="12" style="-fx-background-color:white;-fx-border-color:#D1D5DB;"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding><Label text="Consignar" /><HBox spacing="12"><VBox><Label text="Cuenta destino" /><TextField fx:id="txtCuentaConsignar" prefHeight="44" /></VBox><Button text="Verificar" onAction="#verificarConsignar" prefHeight="44" /><Label fx:id="lblTitularConsignar" /></HBox><HBox spacing="12"><VBox><Label text="Monto" /><TextField fx:id="txtMontoConsignar" prefHeight="44" /></VBox><VBox><Label text="Canal" /><ComboBox fx:id="cbCanalConsignar" prefHeight="44" /></VBox><VBox><Label text="Descripción" /><TextField fx:id="txtDescripcionConsignar" prefHeight="44" /></VBox></HBox><Button text="Ejecutar consignación" onAction="#ejecutarConsignacion" prefHeight="44" /></VBox>
  <VBox fx:id="panelRetirar" spacing="12" visible="false" managed="false" style="-fx-background-color:white;-fx-border-color:#D1D5DB;"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding><Label text="Retirar" /><HBox spacing="12"><VBox><Label text="Cuenta origen" /><TextField fx:id="txtCuentaRetirar" prefHeight="44" /></VBox><Button text="Verificar" onAction="#verificarRetirar" prefHeight="44" /><Label fx:id="lblTitularRetirar" /></HBox><HBox spacing="12"><VBox><Label text="Monto" /><TextField fx:id="txtMontoRetirar" prefHeight="44" /></VBox><VBox><Label text="Canal" /><ComboBox fx:id="cbCanalRetirar" prefHeight="44" /></VBox><VBox><Label text="Descripción" /><TextField fx:id="txtDescripcionRetirar" prefHeight="44" /></VBox></HBox><Button text="Ejecutar retiro" onAction="#ejecutarRetiro" prefHeight="44" /></VBox>
  <VBox fx:id="panelTransferir" spacing="12" visible="false" managed="false" style="-fx-background-color:white;-fx-border-color:#D1D5DB;"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding><Label text="Transferir" /><HBox spacing="12"><VBox><Label text="Cuenta origen" /><TextField fx:id="txtCuentaOrigen" prefHeight="44" /></VBox><Button text="Verificar" onAction="#verificarOrigen" prefHeight="44" /><Label fx:id="lblTitularOrigen" /><VBox><Label text="Cuenta destino" /><TextField fx:id="txtCuentaDestino" prefHeight="44" /></VBox><Button text="Verificar" onAction="#verificarDestino" prefHeight="44" /><Label fx:id="lblTitularDestino" /></HBox><HBox spacing="12"><VBox><Label text="Monto" /><TextField fx:id="txtMontoTransferir" prefHeight="44" /></VBox><VBox><Label text="Canal" /><ComboBox fx:id="cbCanalTransferir" prefHeight="44" /></VBox><VBox><Label text="Descripción" /><TextField fx:id="txtDescripcionTransferir" prefHeight="44" /></VBox></HBox><Button text="Ejecutar transferencia" onAction="#ejecutarTransferencia" prefHeight="44" /></VBox>
  <VBox fx:id="panelComprobante" spacing="8" style="-fx-background-color:#ECFDF5;-fx-border-color:#86EFAC;"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding><Label text="Comprobante" /><Label fx:id="lblComprobante" wrapText="true" /><Button text="Nueva operación" onAction="#nuevaOperacion" prefHeight="44" /></VBox>
  <VBox spacing="8"><Label text="Historial de sesión" /><TableView fx:id="tablaHistorial" prefHeight="220"><columns><TableColumn fx:id="colHora" text="Hora" /><TableColumn fx:id="colTipo" text="Tipo" /><TableColumn fx:id="colCuentas" text="Cuenta(s)" /><TableColumn fx:id="colMonto" text="Monto" /><TableColumn fx:id="colCanal" text="Canal" /></columns></TableView></VBox>
 </VBox></content></ScrollPane></center>
</BorderPane>
